{
	"id": "MooniIngest00001",
	"name": "Mooni — ingestion (IG/TG → AI → модерация)",
	"nodes": [
		{
			"parameters": {},
			"id": "11111111-1111-4111-8111-111111111111",
			"name": "Запуск (тест)",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [-100, 300]
		},
		{
			"parameters": {
				"values": {
					"string": [
						{ "name": "source", "value": "telegram" },
						{ "name": "externalId", "value": "demo-spb-1" },
						{
							"name": "text",
							"value": "Открылась новая независимая кофейня на Петроградке — спешелти-кофе, фильтр, уютный зал с книгами, тихо и можно работать с ноутом. Адрес: ул. Большая Пушкарская. Идеально для спокойного утра."
						}
					]
				},
				"options": {}
			},
			"id": "22222222-2222-4222-8222-222222222222",
			"name": "Сырой пост",
			"type": "n8n-nodes-base.set",
			"typeVersion": 1,
			"position": [120, 300]
		},
		{
			"parameters": {
				"method": "POST",
				"url": "http://127.0.0.1:11434/api/generate",
				"sendBody": true,
				"contentType": "json",
				"specifyBody": "json",
				"jsonBody": "={{ JSON.stringify({ model: \"qwen2.5:14b-instruct\", stream: false, format: \"json\", prompt: \"Ты — парсер городских мест Санкт-Петербурга. По тексту поста верни СТРОГО JSON-объект с полями: name (строка), description (1-2 предложения), district (район СПб или null), categorySlug (ровно одно из: cafe, bar, park, museum, gallery, club, restaurant, landmark, other), tags (массив строк), moodTags (массив из: cozy, romantic, active, calm, party, culture, nature, work). Только JSON, без пояснений. Пост: \" + $json.text }) }}",
				"options": { "timeout": 90000 }
			},
			"id": "33333333-3333-4333-8333-333333333333",
			"name": "AI-структуризация (Ollama)",
			"type": "n8n-nodes-base.httpRequest",
			"typeVersion": 4.2,
			"position": [360, 300]
		},
		{
			"parameters": {
				"values": {
					"string": [
						{
							"name": "source",
							"value": "={{ $('Сырой пост').item.json.source }}"
						},
						{
							"name": "externalId",
							"value": "={{ $('Сырой пост').item.json.externalId }}"
						},
						{
							"name": "text",
							"value": "={{ $('Сырой пост').item.json.text + \"\\n\\n[AI-структура]: \" + $json.response }}"
						}
					]
				},
				"options": {}
			},
			"id": "44444444-4444-4444-8444-444444444444",
			"name": "Сборка payload",
			"type": "n8n-nodes-base.set",
			"typeVersion": 1,
			"position": [600, 300]
		},
		{
			"parameters": {
				"method": "POST",
				"url": "https://mooni.suspectuso.ru/api/ingestion/raw",
				"sendHeaders": true,
				"headerParameters": {
					"parameters": [
						{ "name": "X-Ingest-Secret", "value": "7675b473e8f3d1a4ea47ebcc" }
					]
				},
				"sendBody": true,
				"contentType": "json",
				"specifyBody": "json",
				"jsonBody": "={{ JSON.stringify({ source: $json.source, externalId: $json.externalId, text: $json.text }) }}",
