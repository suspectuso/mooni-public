{
	"name": "mooni",
	"version": "0.1.0",
	"private": true,
	"description": "Mooni — Telegram-суперапп городской жизни СПб. Свайп мест → AI-маршрут.",
	"packageManager": "pnpm@10.25.0",
	"engines": {
		"node": ">=20"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/client",
			"@prisma/engines",
			"prisma",
			"esbuild",
			"sharp",
			"@nestjs/core"
		]
	},
	"scripts": {
		"dev": "pnpm --parallel --filter \"./apps/*\" dev",
		"dev:api": "pnpm --filter @mooni/api dev",
		"dev:web": "pnpm --filter @mooni/web dev",
		"build": "pnpm -r build",
		"lint": "pnpm --filter @mooni/web lint",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"db:generate": "pnpm --filter @mooni/api prisma:generate",
		"db:migrate": "pnpm --filter @mooni/api prisma:migrate",
		"db:seed": "pnpm --filter @mooni/api prisma:seed",
		"db:studio": "pnpm --filter @mooni/api prisma:studio",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"prettier": "^3.4.2",
		"@playwright/test": "^1.49.1"
	}
}
