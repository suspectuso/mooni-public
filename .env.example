# ───── Database ─────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mooni?schema=public"

# ───── Telegram ─────
TELEGRAM_BOT_TOKEN="123456:replace-me"
# initData валидируется этим токеном; в dev можно отключить проверку
AUTH_SKIP_TELEGRAM_VALIDATION="true"
JWT_SECRET="change-me-in-prod"
# бот (long-polling) стартует только при BOT_ENABLED=true — иначе dev перехватит getUpdates у прода
BOT_ENABLED="false"
WEBAPP_URL="https://mooni.suspectuso.ru"

# ───── LLM (локальный Ollama на sus) ─────
# OpenAI-совместимый эндпоинт. Варианты base URL:
#   на самом sus / через SSH-туннель (-L 11434:127.0.0.1:11434): http://localhost:11434/v1
#   через nginx-прокси play2go (Bearer-ключ):                    http://<PROD_HOST>:11435/v1
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama"
LLM_MODEL="qwen2.5:14b-instruct"
# эмбеддинги — нативный Ollama (без /v1)
LLM_EMBED_BASE_URL="http://localhost:11434"
LLM_EMBED_MODEL="nomic-embed-text"

# ───── Ingestion (вебхук для n8n) ─────
INGEST_SECRET="change-me-ingest"
# Афиша-агрегатор: публичный API KudaGo (по умолчанию kudago.com, ключ не нужен)
KUDAGO_BASE_URL="https://kudago.com/public-api/v1.4"
# Погода для маршрутов под погоду/время: open-meteo (бесплатно, без ключей)
OPEN_METEO_URL="https://api.open-meteo.com/v1/forecast"
# Голосовой ввод: ASR-сервер Parakeet v3 (на sus, через SSH-туннель на play2go). Пусто = выкл.
ASR_URL="http://localhost:9001/transcribe"

# ───── Платежи ─────
# ЮKassa (как в Match): dashboard → shopId + секретный ключ
YOOKASSA_SHOP_ID=""
YOOKASSA_API_KEY=""
# xRocket (крипта, USDT): токен Rocket-Pay-Key из @xRocket → Rocket Pay
XROCKET_TOKEN=""
XROCKET_BASE_URL="https://pay.xrocket.tg"
# в dev можно пропускать IP-проверку вебхука ЮKassa
PAYMENTS_WEBHOOK_SKIP_IP="false"
API_URL="https://mooni.suspectuso.ru/api"

# ───── API ─────
API_PORT="8001"
CORS_ORIGIN="http://localhost:3030"

# ───── Web (Next.js) ─────
NEXT_PUBLIC_API_URL="http://localhost:8001"
# Live2D-модель проводника «Муни». По умолчанию вшит бесплатный сэмпл Live2D «Haru» с CDN.
# Чтобы поставить свою модель — указать URL до .model3.json (или пусто = SVG-фолбэк).
NEXT_PUBLIC_LIVE2D_MODEL=""

# только для локальных тестов платежей без Telegram (НЕ в проде)
PAYMENTS_SKIP_INITDATA="false"

# админка (заголовок X-Admin-Token); пусто = админка закрыта
ADMIN_TOKEN=""

# чат для алертов мониторинга (пусто = только лог)
ADMIN_CHAT_ID=""
