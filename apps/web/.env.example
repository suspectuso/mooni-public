# Frontend Environment Variables

# API URL (адрес backend)
# Для продакшена укажите ваш домен
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# Карта (раздел /map): MapLibre GL + OpenFreeMap (OSM). Ключ НЕ нужен — бесплатно, без биллинга.
# Стиль подложки задаётся в коде (components/map/MapScreen.tsx → MAP_STYLE).
